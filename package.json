{
  "name": "movie-tracker-bot",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env dev",
    "deploy:dev": "wrangler deploy --env dev",
    "deploy:prod": "wrangler deploy --env prod",
    "cf-typegen": "wrangler types ./src/types/worker-configuration.d.ts",
    "db:migrate:dev:local": "wrangler d1 migrations apply movie-tracker-bot-db-dev --env dev --local",
    "db:migrate:dev:remote": "wrangler d1 migrations apply movie-tracker-bot-db-dev --env dev --remote",
    "db:migrate:prod": "wrangler d1 migrations apply movie-tracker-bot-db-prod --env prod --remote",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OlegKorniychuk/movie-tracker-bot.git"
  },
  "keywords": [],
  "author": "Oleh Korniichuk",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/OlegKorniychuk/movie-tracker-bot/issues"
  },
  "homepage": "https://github.com/OlegKorniychuk/movie-tracker-bot#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.4.2",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "wrangler": "^4.122.0"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.2",
    "grammy": "^1.45.1"
  }
}
