{
  "name": "movie-tracker-bot",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-13",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "env": {
    "prod": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "movie-tracker-bot-db-prod",
          "database_id": "0c8304fb-dcc2-4f46-b855-ec1a7116f063",
          "migrations_dir": "drizzle",
        },
      ],
      "triggers": {
        "crons": ["0 9 * * 1", "0 9 * * *"],
      },
    },
    "dev": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "movie-tracker-bot-db-dev",
          "database_id": "b58009d8-23c7-4b1d-8a6e-eca6540d75bd",
          "migrations_dir": "drizzle",
        },
      ],
      "triggers": {
        "crons": [
          "0 9 * * 1", // weekly gate check for the biweekly digest (Mon 09:00 UTC)
          "0 9 * * *", // daily release-day reminder check (09:00 UTC)
        ],
      },
    },
  },
}
